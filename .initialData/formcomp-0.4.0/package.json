{
	"name": "formcomp",
	"version": "0.4.0",
	"description": "Config-driven multi-step form component library for Svelte 5 and Tailwind CSS v4",
	"license": "BSD-3-Clause",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/alexpetroni/general-form-comp.git"
	},
	"homepage": "https://github.com/alexpetroni/general-form-comp#readme",
	"bugs": {
		"url": "https://github.com/alexpetroni/general-form-comp/issues"
	},
	"keywords": [
		"svelte",
		"svelte5",
		"form",
		"multi-step",
		"wizard",
		"survey",
		"tailwind",
		"config-driven"
	],
	"type": "module",
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./theme.css": "./dist/theme.css",
		"./package.json": "./package.json"
	},
	"sideEffects": [
		"**/*.css"
	],
	"files": [
		"dist",
		"CHANGELOG.md"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package",
		"dev:lib": "svelte-package --watch",
		"prepare": "npm run package",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch"
	},
	"peerDependencies": {
		"svelte": "^5.0.0",
		"tailwindcss": "^4.0.0"
	},
	"devDependencies": {
		"@playwright/test": "^1.61.1",
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/package": "^2.5.7",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.2.1",
		"jsdom": "^30.0.1",
		"svelte": "^5.51.0",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.2.1",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vitest": "^4.1.9"
	},
	"dependencies": {
		"clsx": "^2.1.1",
		"tailwind-merge": "^3.5.0"
	}
}
