# claude-phase-runner config for the betterSleep build.
# From the kit dir:
#   DRY_RUN=1 bash run.sh /home/alex/work/better-sleep-v15/runner.env   # validate + print prompt
#   bash run.sh preflight /home/alex/work/better-sleep-v15/runner.env   # tooling report only
#   bash run.sh           /home/alex/work/better-sleep-v15/runner.env   # the build
#   bash run.sh review    /home/alex/work/better-sleep-v15/runner.env   # adversarial review
PROJECT_DIR=/home/alex/work/better-sleep-v15
ENTRY_FILE=PROMPT.md
PHASE_FILES="docs/phases/BS-0-REPO-SHAPE.md docs/phases/BS-1-FORMCOMP.md docs/phases/BS-2-ARCHETYPE-QUIZ.md docs/phases/BS-3-EMAIL-CAPTURE.md docs/phases/BS-4-ARTICLES.md docs/phases/BS-5-LANDING.md docs/phases/BS-6-PRODUCTS.md"
RETRY_SCHEDULE="30 300 3600 10800"
# build + e2e run as one silent tool call; 40min was better-base's tuned value for this stack
STALL_TIMEOUT=2400
GATE_CMD="pnpm lint && pnpm check && pnpm test:unit"
PUSH=1
GIT_REMOTE=origin
GIT_BRANCH=main
# Model: set your choice here before launching (left unset on purpose).
#CLAUDE_MODEL=
# Effort passthrough (requires the CLAUDE_EFFORT support patched into the kit's
# driver.sh + docker-compose.yml).
CLAUDE_EFFORT=high
# Chromium system libs for playwright e2e (the container cannot apt-install itself),
# fonts for Romanian diacritics in screenshots, psql for db work.
# Debian 12 names, tuned for this exact stack on node:24-bookworm.
EXTRA_APT_PACKAGES="libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 libcups2 libdrm2 libdbus-1-3 libxkbcommon0 libatspi2.0-0 libx11-6 libx11-xcb1 libxcb1 libxcomposite1 libxdamage1 libxext6 libxfixes3 libxrandr2 libgbm1 libpango-1.0-0 libcairo2 libasound2 libxshmfence1 libglib2.0-0 fonts-liberation fonts-dejavu-core fonts-noto-core postgresql-client"
